# NOTE: the repo-root .env (see ../../.env.example, managed by ./dev.sh) is
# the actual source of truth for MONGO_URI/MONGO_DB and DASHBOARD_JWT_SECRET
# -- it's loaded here too (see app/config.py) and always wins if both exist.
# This file only matters if you're running the backend standalone without
# dev.sh and want per-service overrides instead of touching the root .env.

DASHBOARD_MONGO_URI=mongodb://localhost:27017/ieee?directConnection=true
DASHBOARD_MONGO_DB=ieee
DASHBOARD_JWT_SECRET=change-me-to-a-random-32+-byte-string
DASHBOARD_JWT_EXPIRES_MINUTES=480
DASHBOARD_CORS_ORIGINS=http://localhost:5174
DASHBOARD_COOKIE_SECURE=false
