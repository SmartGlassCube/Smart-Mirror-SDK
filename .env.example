# Copied to .env by `./dev.sh up` on first run (with generated secrets) if
# .env doesn't exist yet. This file is the single source of truth for dev
# config/credentials -- the mirror (smartmirror.content, via MONGO_URI),
# the dashboard backend (dashboard/backend/app/config.py), and dev.sh itself
# all read it. Never commit the real .env (it's gitignored).

MONGO_URI=mongodb://localhost:27017/ieee?directConnection=true

DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=change-me
DASHBOARD_JWT_SECRET=change-me-to-a-random-32+-byte-string
